{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "@gleks/ui": {
      "projectType": "library",
      "schematics": {
        "@schematics/angular:component": {
          "type": "component",
          "style": "scss",
          "changeDetection": "OnPush",
          "standalone": true
        }
      },
      "root": "projects/gleks/ui",
      "sourceRoot": "projects/gleks/ui/src",
      "prefix": "gog",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/gleks/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/gleks/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/gleks/ui/tsconfig.spec.json"
          },
          "configurations": {
            "coverage": {
              "coverage": true,
              "coverageInclude": [
                "projects/gleks/ui/src/**/*.ts"
              ],
              "coverageExclude": [
                "projects/gleks/ui/src/**/*.spec.ts",
                "projects/gleks/ui/src/public-api.ts",
                "projects/gleks/ui/src/lib/shared/token-names.ts"
              ],
              "coverageReporters": [
                "text",
                "lcovonly"
              ],
              "coverageThresholds": {
                "statements": 93,
                "branches": 90,
                "functions": 92,
                "lines": 95
              }
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/gleks/ui/**/*.ts",
              "projects/gleks/ui/**/*.html"
            ],
            "eslintConfig": "projects/gleks/ui/eslint.config.js"
          }
        }
      }
    },
    "ui-showcase": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "type": "component",
          "style": "scss",
          "changeDetection": "OnPush",
          "standalone": true
        }
      },
      "root": "projects/ui-showcase",
      "sourceRoot": "projects/ui-showcase/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ui-showcase/src/main.ts",
            "tsConfig": "projects/ui-showcase/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ui-showcase/public"
              }
            ],
            "styles": [
              "projects/gleks/ui/src/styles/index.css",
              "projects/gleks/ui/src/styles/presets/one-dark.css",
              "projects/gleks/ui/src/styles/presets/one-light.css",
              "projects/ui-showcase/src/styles.scss"
            ],
            "server": "projects/ui-showcase/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/ui-showcase/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ui-showcase:build:production"
            },
            "development": {
              "buildTarget": "ui-showcase:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ui-showcase/**/*.ts",
              "projects/ui-showcase/**/*.html"
            ],
            "eslintConfig": "projects/ui-showcase/eslint.config.js"
          }
        }
      }
    },
    "gleks-ui-lab": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/gleks-ui-lab",
      "sourceRoot": "projects/gleks-ui-lab/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/gleks-ui-lab",
            "browser": "projects/gleks-ui-lab/src/main.ts",
            "tsConfig": "projects/gleks-ui-lab/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/gleks-ui-lab/public"
              },
              {
                "glob": "*.css",
                "input": "node_modules/@guildofgleks/ui/styles",
                "output": "docs/styles"
              },
              {
                "glob": "*.css",
                "input": "node_modules/@guildofgleks/ui/styles/presets",
                "output": "docs/styles/presets"
              },
              {
                "glob": "CHANGELOG.md",
                "input": "node_modules/@guildofgleks/ui",
                "output": "docs"
              }
            ],
            "styles": [
              "node_modules/@guildofgleks/ui/styles/index.css",
              "node_modules/@guildofgleks/ui/styles/presets/slate.css",
              "node_modules/@guildofgleks/ui/styles/presets/one-dark.css",
              "node_modules/@guildofgleks/ui/styles/presets/one-light.css",
              "projects/gleks-ui-lab/src/styles.scss"
            ],
            "server": "projects/gleks-ui-lab/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/gleks-ui-lab/src/server.ts"
            },
            "allowedCommonJsDependencies": [
              "@fortawesome/free-solid-svg-icons",
              "@fortawesome/angular-fontawesome"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "700kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "gleks-ui-lab:build:production"
            },
            "development": {
              "buildTarget": "gleks-ui-lab:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/gleks-ui-lab/**/*.ts",
              "projects/gleks-ui-lab/**/*.html"
            ],
            "eslintConfig": "projects/gleks-ui-lab/eslint.config.js"
          }
        }
      }
    }
  }
}

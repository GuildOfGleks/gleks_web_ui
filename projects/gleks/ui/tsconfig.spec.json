/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/spec",
    "types": ["vitest/globals"],
    /*
     * Specs compile from source, so every entry point resolves to its source barrel -- the same
     * files the relative imports inside each directory reach, which is what keeps `GOG_CONFIG` one
     * token and each component one class under test as well as in a build. Replaces the root's
     * `paths` rather than merging with them. `@guildofgleks/ui` is needed since 21.14.0, when the
     * table, datepicker and dialog moved out of `src/` and started importing the root by name.
     */
    "paths": {
      "@guildofgleks/ui": ["./src/public-api.ts"],
      "@guildofgleks/ui/*": ["./*/public-api.ts"]
    }
  },
  "include": ["src/**/*.d.ts", "*/**/*.spec.ts"],
  "exclude": ["node_modules", "schematics/**"]
}

{
  "name": "gleks-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "buildLibAndStart": "npm run build:lib && npm run start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:lib": "ng build @gleks/ui",
    "test:lib": "ng test @gleks/ui",
    "build:showcase": "ng build ui-showcase",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,css}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,css}\"",
    "lint": "ng lint @gleks/ui && ng lint ui-showcase",
    "check:tokens": "node scripts/check-tokens.mjs",
    "serve:ssr:ui-showcase": "node dist/ui-showcase/server/server.mjs",
    "build:ssr:ui-showcase": "ng run ui-showcase:server:production",
    "build:ssr:ui-showcase:dev": "ng run ui-showcase:server:development",
    "release": "npm run build:lib && npm publish dist/gleks/ui --access public"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.18",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}

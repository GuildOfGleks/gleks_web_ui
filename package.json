{
  "name": "gleks-ui-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:lib": "ng build @gleks/ui && node scripts/build-schematics.mjs --dist",
    "test:lib": "ng test @gleks/ui",
    "test:lib:coverage": "ng test @gleks/ui --configuration coverage",
    "test:schematics": "node scripts/build-schematics.mjs && node --test out-tsc/schematics/ng-add/index.spec.cjs",
    "build:showcase": "ng build ui-showcase",
    "start:lab": "ng serve gleks-ui-lab",
    "build:lab": "node scripts/generate-example-sources.mjs --check && node scripts/build-lab.mjs",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,css}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,css}\"",
    "lint": "ng lint @gleks/ui && ng lint ui-showcase && ng lint gleks-ui-lab",
    "check:tokens": "node scripts/check-tokens.mjs && node scripts/generate-tokens.mjs --check",
    "check:deprecations": "node scripts/check-deprecations.mjs && node scripts/generate-deprecations.mjs --check",
    "serve:ssr:ui-showcase": "node dist/ui-showcase/server/server.mjs",
    "buildLibAndStart": "npm run build:lib && ng serve ui-showcase",
    "release": "npm run check:release && npm run build:lib && npm publish dist/gleks/ui --access public",
    "serve:ssr:gleks-ui-lab": "node dist/gleks-ui-lab/server/server.mjs",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "generate:deprecations": "node scripts/generate-deprecations.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "check:logical-properties": "node scripts/check-logical-properties.mjs",
    "check:state-specificity": "node scripts/check-state-specificity.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:sitemap": "node scripts/generate-sitemap.mjs --check",
    "ping:indexnow": "node scripts/ping-indexnow.mjs",
    "generate:examples": "node scripts/generate-example-sources.mjs",
    "check:examples": "node scripts/generate-example-sources.mjs --check"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.18",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@guildofgleks/ui": "^21.5.2",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^21.2.0",
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@schematics/angular": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.0.8"
  }
}
